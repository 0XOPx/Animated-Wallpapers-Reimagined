#include <windows.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0" // US English, Unicode
        BEGIN
            VALUE "CompanyName",      "OXOP"
            VALUE "FileDescription",  "Animated Wallpapers Reimagined"
            VALUE "FileVersion",      "1.0.0.1"
            VALUE "InternalName",     "wallpaper"
            VALUE "LegalCopyright",   "Copyright (C) 2026 OXOP. All Rights Reserved."
            VALUE "LegalTrademarks",  "Trademark owned by OXOP."
            VALUE "OriginalFilename", "wallpaper.exe"
            VALUE "ProductName",      "Animated Wallpapers Reimagined"
            VALUE "ProductVersion",   "1.0.0.1"
            VALUE "Creator",          "OXOP"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END